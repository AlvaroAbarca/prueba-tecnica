
TZ="UTC"
PORT = "8003" # Puerto de despliegue
NODE_ENV = "DEV"  #local tu nombre: IGNACIO, para despliegue en ambiente: DEV, QA o PROD

# configuracion para documentacion de api swagger
PROJECT_NAME = "Proyecto Arquetipo Backend"
PROJECT_DESCRIPTION = "Proyecto Arquetipo Backend API"
PROJECT_VERSION = "0.0.1"

# configuracion de la base de datos
BD_HOST = "localhost"
BD_USER = "postgres"
BD_PASS = "postgres"
BD_PORT = 5432
BD_SCHEMA = "postgres"
BD_POOL_MAX = 20

# configuracion para enviar logs a loki
LOKI_ENABLED = "true"
LOKI_LEVEL= "debug" # debug, info, warn, error
LOKI_ENDPOINT_ENABLED = "true"
LOKI_URL=
LOKI_SERVICE = "PROYECTO-ARQUETIPO"

# configuracion para logs en archivos
LOG_ENABLED = "false"
LOG_LEVEL = "debug" # debug, info, warn, error
LOG_DIR = "./logs"

# configuracion para keycloak
KEYCLOAK_AUTH_SERVER_URL =
KEYCLOAK_REALM =
KEYCLOAK_CLIENT_ID =
KEYCLOAK_SECRET =
KEYCLOAK_PUBLIC_KEY =

# Configuracion de CORS
CORS_ENABLED = "true"
CORS_ALLOW_ORIGIN = "*"
CORS_ALLOW_METHODS = "GET, POST, PUT, DELETE, OPTIONS"
CORS_ALLOW_HEADERS = "Content-Type, Authorization, X-Requested-With, Accept, Origin"

# Configuracion de JWT para los TOKENS
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_AUDIENCE=
JWT_ISSUER=

# configuracion para la expiracion de los tokens y las cookies httpOnly en segundos
ACCESS_TOKEN_EXPIRES= 900 # 15 minutes
REFRESH_TOKEN_EXPIRES= 1800 # 30 minutes

# configuracion para envio de correos
EMAIL_RESEND_APIKEY =
EMAIL_RESEND_FROM =

FRONTEND_URL = "http://localhost:8005"

# SONAR Back
SONAR_TOKEN=
