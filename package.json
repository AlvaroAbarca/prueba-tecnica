{
  "name": "arquetipo-back",
  "description": "Arquetipo - Backend",
  "version": "1.0.0",
  "author": "CorreosChile 2026",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "formatLint": "npm run format && npm run lint",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration": "npm run typeorm -- migration:run -d ./src/modules/shared/infrastructure/orm/dataSource.ts",
    "migration:run": "npm run typeorm -- migration:run -d ./src/modules/shared/infrastructure/orm/dataSource.ts",
    "migration:create": "sh -c 'npm run typeorm -- migration:create ./migrations/$0'",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/modules/shared/infrastructure/orm/dataSource.ts",
    "migration:show": "npm run typeorm -- migration:show -d ./src/modules/shared/infrastructure/orm/dataSource.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.21",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.21",
    "@nestjs/platform-express": "11.1.21",
    "@nestjs/swagger": "11.4.3",
    "@nestjs/typeorm": "11.0.1",
    "bcrypt": "6.0.0",
    "body-parser": "2.2.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "dayjs": "1.11.20",
    "dotenv": "17.3.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "log4js": "6.9.1",
    "morgan": "1.10.1",
    "nanoid": "5.1.7",
    "pg": "8.20.0",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.4",
    "typeorm": "0.3.28",
    "uuid": "9.0.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.21",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "1.4.13",
    "@types/node": "20.19.37",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "oxlint": "1.56.0",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "glob": ">=11.0.4",
    "rimraf": "5.0.0",
    "inflight": "npm:@npmcli/promise-spawn@6.0.0",
    "test-exclude": "7.0.0",
    "diff": "8.0.3",
    "minimatch": ">=10.2.3",
    "serialize-javascript": "7.0.3",
    "path-to-regexp": "8.4.0",
    "node-forge": "1.4.0",
    "@angular-devkit/core": {
      "ajv": "8.18.0",
      "picomatch": "4.0.4"
    },
    "@nestjs/schematics": {
      "ajv": "8.18.0"
    }
  },
  "allowScripts": {
    "@nestjs/core@11.1.21": true,
    "@scarf/scarf@1.4.0": true,
    "bcrypt@6.0.0": true
  }
}
